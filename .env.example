# Supabase — obrigatório para autenticação real, pedidos e armazenamento privado
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: use SOMENTE no servidor. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública usada para montar o link seguro do pedido
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# WhatsApp do vendedor no formato internacional, apenas dígitos (ex.: 5583999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=
